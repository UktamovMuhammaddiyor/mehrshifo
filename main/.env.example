# Per-environment config. Copy to `main/.env` and fill in for THIS machine.
#   cp .env.example .env
# `.env` is git-ignored — never commit real tokens/keys. One .env per machine:
# the dev machine gets dev values, the prod host gets prod values.

# ----------------------------------------------------------------------------
# Which environment this machine is. Controls the default database file:
#   prod          -> db.sqlite3      (the live database)
#   anything else -> db.dev.sqlite3  (isolated; e.g. "staging")
APP_ENV=staging

# Django debug. MUST be False in prod.
#   dev:  True
#   prod: False
DEBUG=True

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# dev:  any fresh key.
# prod: keep the EXISTING key already in use, or rotating it logs admins out.
SECRET_KEY=replace-me

# Comma-separated hosts Django will serve. Must include the host of WEBHOOK_URL.
#   dev:  <your-subdomain>.ngrok-free.app,127.0.0.1
#   prod: your-prod-domain.com
ALLOWED_HOSTS=127.0.0.1

# Telegram bot token from @BotFather (the staging bot for dev, the live bot for
# prod). BOT_URL is derived as https://api.telegram.org/bot<BOT_TOKEN>/.
BOT_TOKEN=123456:replace-me

# Full public HTTPS URL Telegram posts updates to — must end in /getpost/.
#   dev:  https://<your-subdomain>.ngrok-free.app/getpost/
#   prod: https://your-prod-domain.com/getpost/
WEBHOOK_URL=https://example.ngrok-free.app/getpost/

# Password for /getadmin and group activation. Use a DIFFERENT value per env so
# the staging bot can't be driven with the prod password (and vice versa).
BOT_ADMIN_PASSWORD=replace-me

# Optional: override the database filename explicitly (otherwise derived from
# APP_ENV as above).
# DB_NAME=db.dev.sqlite3

# --- AI customer support ---
OPENAI_API_KEY=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_USER_IDS=
